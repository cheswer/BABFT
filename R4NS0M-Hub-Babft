-- Los scripts de Roblox que manejan los controles tactiles (PlayerModule) deben ver
-- siempre el dispositivo REAL; asi el stick y el boton de salto no desaparecen.
local function inControlModule(inst)
    local ps = LP:FindFirstChild("PlayerScripts")
    local pm = ps and ps:FindFirstChild("PlayerModule")
    return pm ~= nil and typeof(inst) == "Instance" and (inst == pm or inst:IsDescendantOf(pm))
end
local function fromControlModule()
    if not getcallingscript then return false end
    local ok, cs = pcall(getcallingscript)
    return ok and cs ~= nil and inControlModule(cs)
end

local Cursor = { on = false, x = 400, y = 300 }
local MouseObj = LP:GetMouse()
local function cursorHit()
    local cam = workspace.CurrentCamera
    local ray = cam:ViewportPointToRay(Cursor.x, Cursor.y)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { LP.Character }
    return ray, workspace:Raycast(ray.Origin, ray.Direction * 1000, params)
end

local hooksInstalled = false
local function installHooks()
    if hooksInstalled then return true end
    if not (hookmetamethod and checkcaller and getnamecallmethod) then return false end
    hooksInstalled = true
    local wrap = newcclosure or function(f) return f end
    local oldIdx
    oldIdx = hookmetamethod(game, "__index", wrap(function(self, key)
        if self == UIS then
            if Device.mode ~= "Off" and not checkcaller() then
                local v = DevProfiles[Device.mode][key]
                if type(v) == "boolean" and not (Device.keepControls and fromControlModule()) then return v end
            end
        elseif Cursor.on and self == MouseObj and not checkcaller() then
            -- el juego "ve" el mouse virtual
            if key == "X" then return Cursor.x end
            if key == "Y" then return Cursor.y - GuiService:GetGuiInset().Y end
            if key == "Hit" or key == "Target" or key == "UnitRay" or key == "Origin" then
                local ray, res = cursorHit()
                if key == "Hit" then return CFrame.new(res and res.Position or (ray.Origin + ray.Direction * 1000)) end
                if key == "Target" then return res and res.Instance end
                if key == "UnitRay" then return Ray.new(ray.Origin, ray.Direction) end
                return CFrame.new(ray.Origin, ray.Origin + ray.Direction)
            end
        end
        return oldIdx(self, key)
    end))
    local oldNC
    oldNC = hookmetamethod(game, "__namecall", wrap(function(self, ...)
        if Cursor.on and self == UIS and getnamecallmethod() == "GetMouseLocation" and not checkcaller() then
            return Vector2.new(Cursor.x, Cursor.y)
        end
        if Device.mode ~= "Off" and not checkcaller() then
            local m = getnamecallmethod()
            local prof = DevProfiles[Device.mode]
            if self == UIS and Device.keepControls
                and (m == "GetLastInputType" or m == "GetPlatform" or m == "GetGamepadConnected" or m == "GamepadSupports")
                and fromControlModule() then
                return oldNC(self, ...)
            end
            if self == UIS then
                if m == "GetLastInputType" then return prof.lastInput end
                if m == "GetPlatform" and Device.platform then return prof.platform end
                if m == "GetGamepadConnected" or m == "GamepadSupports" then return Device.mode == "Console" end
            elseif self == GuiService and m == "IsTenFootInterface" and Device.platform then
                return Device.mode == "Console"
            end
        end
        return oldNC(self, ...)
    end))
    return true
end

local function pulseInput()
    if Device.mode == "Off" then
        -- volver a la normalidad: se avisa a todos el tipo de input real
        if firesignal then pcall(function() firesignal(UIS.LastInputTypeChanged, UIS:GetLastInputType()) end) end
        return
    end
    local prof = DevProfiles[Device.mode]
    if not prof then return end
    if Device.keepControls and getconnections then
        -- se avisa a todos menos al modulo de controles (si no, cambiaria a teclado y quitaria el stick)
        for _, c in ipairs(getconnections(UIS.LastInputTypeChanged)) do
            local fn = c.Function
            if fn then
                local ok, env = pcall(getfenv, fn)
                local sc = ok and type(env) == "table" and env.script
                if not inControlModule(sc) then pcall(fn, prof.lastInput) end
            end
        end
    elseif not Device.keepControls and firesignal then
        pcall(function() firesignal(UIS.LastInputTypeChanged, prof.lastInput) end)
    end
end

