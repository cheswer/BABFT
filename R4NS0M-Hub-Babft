local farmStatus = TabFarm:Paragraph({ Title = "Status", Desc = "Idle" })
local function setStatus(t) pcall(function() farmStatus:SetDesc(t) end) end

local function farmOnce()
    if not stagesFolder() then setStatus("Stages not found (are you in the right server?)") return false end
    for i = 1, 10 do
        if not S.farm then return false end
        local p = stagePart(i)
        if p then
            setStatus(("Stage %d / 10"):format(i))
            if S.platforms then platform(i, p.Position + Vector3.new(0, 1.5, 0)) end
            tpTo(p.CFrame + Vector3.new(0, 5, 0))
        end
        task.wait(S.stageDelay)
    end
    if not S.farm then return false end
    local t = chestTrigger()
    if t then
        setStatus("Golden chest")
        tpTo(t.CFrame + Vector3.new(0, 3, 0))
        pcall(function()
            local r = hrp()
            if r and firetouchinterest then
                firetouchinterest(r, t, 0) task.wait() firetouchinterest(r, t, 1)
            end
        end)
    end
    local old, waited = char(), 0
    setStatus("Waiting for respawn")
    while S.farm and char() == old and waited < S.respawnWait do
        task.wait(0.5) waited += 0.5
    end
    task.wait(1.5)
    Stats.runs += 1
    return true
end

local farmThread
local function setFarm(v)
    S.farm = v
    if not v then clearPlatforms() end
    if v and not farmThread then
        if S.platforms then buildAllPlatforms() end
        farmThread = task.spawn(function()
            local runs = 0
            while S.farm do
                if not farmOnce() then break end
                runs += 1
                if S.runLimit > 0 and runs >= S.runLimit then break end
            end
            S.farm = false
            farmThread = nil
            clearPlatforms()
            setStatus("Idle")
        end)
    end
end
