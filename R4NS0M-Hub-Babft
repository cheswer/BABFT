local httpReq = (syn and syn.request) or (http and http.request) or http_request or request or (fluxus and fluxus.request)

local function cloudReady()
    return httpReq ~= nil and not CLOUD_URL:find("TU_PROYECTO", 1, true)
end

-- devuelve ok, data|error
local function cloud(method, path, body)
    if not cloudReady() then return false, "Cloud not configured (set CLOUD_URL at the top of the script)" end
    local ok, res = pcall(httpReq, {
        Url = CLOUD_URL .. path, Method = method,
        Headers = { ["Content-Type"] = "application/json" },
        Body = body ~= nil and HttpService:JSONEncode(body) or nil,
    })
    if not ok or not res then return false, "Request failed" end
    local code = res.StatusCode or 0
    if code < 200 or code >= 300 then return false, ("HTTP %d"):format(code) end
    local decoded
    if res.Body and res.Body ~= "" then
        local ok2, d = pcall(HttpService.JSONDecode, HttpService, res.Body)
        if ok2 then decoded = d end
    end
    return true, decoded
end

