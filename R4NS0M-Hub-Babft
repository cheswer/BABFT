local JOY_KEYS = { W = Enum.KeyCode.W, A = Enum.KeyCode.A, S = Enum.KeyCode.S, D = Enum.KeyCode.D }
local function joyApply(obj, vec)
    if S.joyMode ~= "Move only" then
        local want = { W = vec.Y < -0.35, S = vec.Y > 0.35, A = vec.X < -0.35, D = vec.X > 0.35 }
        for k, down in pairs(want) do
            if (obj.keys[k] or false) ~= down then
                obj.keys[k] = down
                sendKey(JOY_KEYS[k], down)
            end
        end
    end
    if S.joyMode ~= "Keys only" then
        TK.move = (vec.Magnitude > 0.15) and Vector3.new(vec.X, 0, vec.Y) or nil
    end
end
local function joyRelease(obj, thumb)
    for k, down in pairs(obj.keys) do
        if down then sendKey(JOY_KEYS[k], false) end
        obj.keys[k] = false
    end
    TK.move = nil
    if thumb then thumb.Position = UDim2.fromScale(0.5, 0.5) end
end
-- mover al personaje directamente (funciona aunque el juego cambie de controlador)
pcall(function() RunService:UnbindFromRenderStep("R4N_JoyMove") end)
RunService:BindToRenderStep("R4N_JoyMove", Enum.RenderPriority.Last.Value, function()
    local v = TK.move
    if v then
        local h = hum()
        if h then h:Move(v, true) end
    end
end)

local function tkFire(def, down)
    if def.action then
        if down then local f = ACTIONS[def.action] if f then f() end end
        return
    end
    sendKey(def.parsed, down)
end

local function tkClearObjs()
    TK.move = nil
    for id, o in pairs(TK.objs) do
        if o.keys then
            for k, down in pairs(o.keys) do if down then sendKey(JOY_KEYS[k], false) end end
        end
        pcall(function() o.conn:Disconnect() end)
        pcall(function() o.b:Destroy() end)
        TK.objs[id] = nil
    end
end

local function tkStyle()
    for _, o in pairs(TK.objs) do
        o.stroke.Color = S.tkLocked and GOLD or RED
