local function refreshCatalog()
    local q = "/catalog.json?orderBy=" .. HttpService:UrlEncode('"$key"') .. "&limitToLast=150"
    local ok, data = cloud("GET", q)
    if not ok then notify("Catalog", tostring(data), 5, "x") return end
    data = type(data) == "table" and data or {}
    local filter = (S.catSearch or ""):lower()
    local list = {}
    for id, m in pairs(data) do
        if type(m) == "table" and type(m.name) == "string" then
            local mine = m.authorId == LP.UserId
            local visible = (tonumber(m.reports) or 0) < HIDE_AT_REPORTS or mine
            local pass = (S.catBrowse ~= "Mine" or mine)
                and (filter == "" or (m.name .. " " .. tostring(m.author or "") .. " " .. tostring(m.desc or "")):lower():find(filter, 1, true))
            if visible and pass then m.id = id list[#list + 1] = m end
        end
    end
    if S.catSort == "Popular" then
        table.sort(list, function(x, y) return (tonumber(x.downloads) or 0) > (tonumber(y.downloads) or 0) end)
    else
        table.sort(list, function(x, y) return x.id > y.id end)
    end
    Cat.map, Cat.sel = {}, nil
    local labels = {}
    for _, m in ipairs(list) do
        local label = ("%s  |  %s  |  %d blocks"):format(m.name:sub(1, 28), tostring(m.author or "?"):sub(1, 14), tonumber(m.blocks) or 0)
        local base, n = label, 1
        while Cat.map[label] do n += 1 label = base .. " #" .. n end
        Cat.map[label] = m
        labels[#labels + 1] = label
    end
    if #labels == 0 then labels = { "(no results)" } end
    pcall(function() catDropdown:Refresh(labels) end)
    notify("Catalog", ("%d builds"):format(#list), 3, "search")
end
