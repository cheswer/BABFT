local function parseKey(str)
    local l = tostring(str or ""):gsub("%s", ""):lower()
    if l == "" then return nil end
    if l == "mouse1" or l == "click" or l == "lmb" then return "M1" end
    if l == "mouse2" or l == "rmb" then return "M2" end
    local a = keyAlias[l]
    if a then return Enum.KeyCode[a] end
    for _, kc in ipairs(Enum.KeyCode:GetEnumItems()) do
        if kc.Name:lower() == l then return kc end
    end
end

