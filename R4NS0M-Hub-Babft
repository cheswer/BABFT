---------------------------------------------------------------- IMAGE BUILDER
-- devuelve { w, h, px = { "RRGGBB" | false, ... } } (false = transparente)
local function hex(r, g, b) return ("%02X%02X%02X"):format(r, g, b) end

local function fetchPixels(src, targetW)
    src = src:gsub("^%s+", ""):gsub("%s+$", "")
    if src == "" then return nil, "Enter an asset ID, file name or URL" end

    -- 1) JSON (archivo o URL): { "w":N, "h":N, "px":["RRGGBB", ...] }
    local raw
    if src:match("^https?://") then
        local ok, res = pcall(game.HttpGet, game, src)
        if ok then raw = res end
    elseif fsOk and not src:match("^%d+$") then
        local ok, res = pcall(readfile, IMG_DIR .. "/" .. src:gsub("%.json$", "") .. ".json")
        if ok then raw = res end
    end
    if raw then
        local ok, d = pcall(HttpService.JSONDecode, HttpService, raw)
        if ok and type(d) == "table" and d.w and d.h and d.px then return d end
        return nil, "Invalid pixel JSON"
    end

    -- 2) asset id via EditableImage
    local id = src:match("(%d+)")
    if not id then return nil, "File not found" end
    local ok, img = pcall(function()
        return AssetService:CreateEditableImageAsync(Content.fromAssetId(tonumber(id)))
    end)
    if not ok or not img then return nil, "Executor can't read that asset (EditableImage unavailable)" end
    local sz = img.Size
    local buf = img:ReadPixelsBuffer(Vector2.zero, sz)
    local w = math.min(targetW, sz.X)
    local h = math.max(1, math.floor(sz.Y * (w / sz.X)))
    local px = table.create(w * h, false)
    for y = 0, h - 1 do
        for x = 0, w - 1 do
            local sx = math.min(sz.X - 1, math.floor((x + 0.5) * sz.X / w))
            local sy = math.min(sz.Y - 1, math.floor((y + 0.5) * sz.Y / h))
            local o = (sy * sz.X + sx) * 4
            if buffer.readu8(buf, o + 3) >= 128 then
                px[y * w + x + 1] = hex(buffer.readu8(buf, o), buffer.readu8(buf, o + 1), buffer.readu8(buf, o + 2))
            end
        end
    end
    pcall(function() img:Destroy() end)
    return { w = w, h = h, px = px }
end

local function pixelsToBlocks(d)
    local blocks = {}
    local ps = S.imgPixel
    local w, h = d.w, d.h
    local function add(x0, y, run, color)
        local cx = (x0 + (run - 1) / 2 - (w - 1) / 2) * ps
        local cy = ((h - 1) / 2 - y) * ps
        local b = { n = S.imgBlock, c = color }
        if S.imgOrient == "Floor" then
            b.p = { cx, 0, -cy } b.r = { 0, 0, 0 } b.s = { run * ps, ps, ps }
        elseif S.imgOrient == "Wall X" then
            b.p = { cx, cy + (h * ps) / 2, 0 } b.r = { 0, 0, 0 } b.s = { run * ps, ps, ps }
        else -- Wall Z
            b.p = { 0, cy + (h * ps) / 2, cx } b.r = { 0, 90, 0 } b.s = { run * ps, ps, ps }
        end
        blocks[#blocks + 1] = b
    end
    for y = 0, h - 1 do
        local x = 0
        while x < w do
            local c = d.px[y * w + x + 1]
            if c then
                local run = 1
                if S.imgMerge then
                    while x + run < w and d.px[y * w + x + run + 1] == c do run += 1 end
                end
                add(x, y, run, c)
                x += run
            else
                x += 1
            end
        end
    end
    return blocks
end

