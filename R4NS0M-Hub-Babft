local Device = { mode = "Off", platform = true, keepControls = true }
local DevProfiles = {
    PC = { TouchEnabled = false, KeyboardEnabled = true, MouseEnabled = true, GamepadEnabled = false,
           lastInput = Enum.UserInputType.Keyboard, platform = Enum.Platform.Windows },
    Mobile = { TouchEnabled = true, KeyboardEnabled = false, MouseEnabled = false, GamepadEnabled = false,
           lastInput = Enum.UserInputType.Touch, platform = Enum.Platform.Android },
