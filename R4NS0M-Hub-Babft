local function resolvePath(str)
    local cur = game
    for part in str:gmatch("[^%.]+") do
        if part == "game" then cur = game
        elseif part == "workspace" then cur = workspace
        else cur = cur and cur:FindFirstChild(part) end
    end
    return cur
end

local function hasParts(i)
    return i and not i:FindFirstChildOfClass("Humanoid") and i:FindFirstChildWhichIsA("BasePart", true) ~= nil
end

local function findBoat()
    if S.boatPath ~= "" then
        local r = resolvePath(S.boatPath)
        return hasParts(r) and r or nil
    end
    local names = { LP.Name, LP.DisplayName }
    if LP.Team then table.insert(names, LP.Team.Name) end
    local roots = { workspace, workspace:FindFirstChild("Blocks"), workspace:FindFirstChild("Boats"), workspace:FindFirstChild("Players") }
    for _, root in ipairs(roots) do
        if root then
            for _, n in ipairs(names) do
                local c = root:FindFirstChild(n)
                if c and c ~= char() and hasParts(c) then return c end
            end
        end
    end
end

local function collectBoat(container)
    local items = {}
    for _, ch in ipairs(container:GetChildren()) do
        local cf, size, color
        if ch:IsA("Model") then
            cf, size = ch:GetPivot(), ch:GetExtentsSize()
            local bp = ch:FindFirstChildWhichIsA("BasePart", true)
            color = bp and bp.Color
        elseif ch:IsA("BasePart") then
            cf, size, color = ch.CFrame, ch.Size, ch.Color
        end
        if cf then items[#items + 1] = { n = ch.Name, cf = cf, size = size, color = color } end
    end
    if #items == 0 then return nil end
    local sx, sz, minY = 0, 0, math.huge
    for _, it in ipairs(items) do
        sx += it.cf.Position.X sz += it.cf.Position.Z
        minY = math.min(minY, it.cf.Position.Y - it.size.Y / 2)
    end
    local ref = Vector3.new(sx / #items, minY, sz / #items)
    local out = {}
    for i, it in ipairs(items) do
        local pos = it.cf.Position - ref
        local rx, ry, rz = (it.cf - it.cf.Position):ToEulerAnglesXYZ()
        out[i] = {
            n = it.n,
            p = { r2(pos.X), r2(pos.Y), r2(pos.Z) },
            r = { r2(math.deg(rx)), r2(math.deg(ry)), r2(math.deg(rz)) },
            c = it.color and it.color:ToHex():upper() or nil,
            s = { r2(it.size.X), r2(it.size.Y), r2(it.size.Z) },
        }
    end
    return out
end

