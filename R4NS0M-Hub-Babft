track(RunService.Heartbeat:Connect(function()
    local h = hum()
    if h then
        if S.speedOn then h.WalkSpeed = S.speed end
        if S.jumpOn then h.UseJumpPower = true h.JumpPower = S.jump end
    end
    if S.fullbright then
        Lighting.Brightness = 2 Lighting.ClockTime = 14
        Lighting.GlobalShadows = false Lighting.Ambient = Color3.fromRGB(200, 200, 200)
    end
    -- fly
    local r = hrp()
    if S.fly and r and h then
        if not flyBV then
            flyBV = Instance.new("BodyVelocity")
            flyBV.MaxForce = Vector3.new(9e9, 9e9, 9e9)
            flyBV.Parent = r
        end
        h.PlatformStand = true
        local cam = workspace.CurrentCamera
        local look = cam.CFrame.LookVector
        local move = h.MoveDirection
        local vel = move * S.flySpeed
        if move.Magnitude > 0 then
            local flat = Vector3.new(look.X, 0, look.Z)
            if flat.Magnitude > 0 then
                vel += Vector3.new(0, look.Y * move:Dot(flat.Unit) * S.flySpeed, 0)
            end
        end
        if UIS:IsKeyDown(Enum.KeyCode.Space) then vel += Vector3.new(0, S.flySpeed, 0) end
        if UIS:IsKeyDown(Enum.KeyCode.LeftShift) then vel -= Vector3.new(0, S.flySpeed, 0) end
        flyBV.Velocity = vel
    end
end))

---------------------------------------------------------------- PLATAFORMAS (solo cliente)
local Platforms = {}
local function platform(key, pos)
    local pl = Platforms[key]
    if not pl or not pl.Parent then
        pl = Instance.new("Part")
        pl.Name = "R4N_Platform"
        pl.Anchored = true pl.CanCollide = true pl.CanQuery = false pl.CanTouch = false
        pl.CastShadow = false
        pl.Material = Enum.Material.Neon
        pl.Color = Color3.fromHex("#F5B83D")
        pl.Transparency = 0.55
        pl.Parent = workspace
        Platforms[key] = pl
    end
    pl.Size = Vector3.new(S.platSize, 1, S.platSize)
    pl.CFrame = CFrame.new(pos)
    return pl
end
local function clearPlatforms()
    for k, pl in pairs(Platforms) do pcall(function() pl:Destroy() end) Platforms[k] = nil end
end
local function buildAllPlatforms()
    for i = 1, 10 do
        local sp = stagePart(i)
        if sp then platform(i, sp.Position + Vector3.new(0, 1.5, 0)) end
    end
end

