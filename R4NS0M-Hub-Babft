---------------------------------------------------------------- BLUEPRINTS (archivos)
local fsOk = typeof(writefile) == "function" and typeof(readfile) == "function"
    and typeof(isfolder) == "function" and typeof(makefolder) == "function" and typeof(listfiles) == "function"
local BP_DIR, IMG_DIR = FOLDER .. "/blueprints", FOLDER .. "/images"
if fsOk then
    for _, d in ipairs({ FOLDER, BP_DIR, IMG_DIR }) do
        if not isfolder(d) then pcall(makefolder, d) end
    end
end

local function listNames(dir)
    local out = {}
    if not fsOk then return out end
    local ok, files = pcall(listfiles, dir)
    if ok then
        for _, f in ipairs(files) do
            local n = f:match("([^/\\]+)%.json$")
            if n then table.insert(out, n) end
        end
    end
    table.sort(out)
    return out
end

local function num(v, lim)
    if type(v) ~= "number" or v ~= v then return 0 end
    return math.clamp(v, -lim, lim)
end
-- sanea cualquier blueprint (local, nube o importado): limita tamaños y valores raros
local function cleanBlocks(list)
    if type(list) ~= "table" then return nil end
    local out = {}
    for i = 1, math.min(#list, 8000) do
        local b = list[i]
        if type(b) == "table" and type(b.n) == "string" and type(b.p) == "table" then
            local nb = { n = b.n:sub(1, 40), p = { num(b.p[1], 3000), num(b.p[2], 3000), num(b.p[3], 3000) } }
            local r = type(b.r) == "table" and b.r or { 0, 0, 0 }
            nb.r = { num(r[1], 360), num(r[2], 360), num(r[3], 360) }
            if type(b.c) == "string" and b.c:match("^%x%x%x%x%x%x$") then nb.c = b.c end
            if type(b.s) == "table" then
                nb.s = { math.clamp(math.abs(num(b.s[1], 64)), 0.1, 64),
                         math.clamp(math.abs(num(b.s[2], 64)), 0.1, 64),
                         math.clamp(math.abs(num(b.s[3], 64)), 0.1, 64) }
            end
            out[#out + 1] = nb
        end
    end
    return out
end

--[[ Formato del blueprint (.json):
{ "blocks": [ { "n":"WoodBlock", "p":[x,y,z], "r":[rx,ry,rz], "c":"RRGGBB", "s":[sx,sy,sz] }, ... ] }
p = posicion relativa al origen (stud), r = rotacion en grados, s = escala (opcional) ]]
local function loadBlueprint(name)
    if not fsOk then return nil, "File system not available" end
    local ok, data = pcall(function() return HttpService:JSONDecode(readfile(BP_DIR .. "/" .. name .. ".json")) end)
    if not ok or type(data) ~= "table" or type(data.blocks) ~= "table" then return nil, "Invalid blueprint" end
    local clean = cleanBlocks(data.blocks)
    if not clean or #clean == 0 then return nil, "Empty blueprint" end
    return clean
end

local function r2(n) return math.floor(n * 100 + 0.5) / 100 end

local function safeName(n)
    n = tostring(n or ""):gsub("[^%w_%- ]", "_"):gsub("^%s+", ""):gsub("%s+$", "")
    return n:sub(1, 40)
end

local function saveBlueprint(name, blocks)
    if not fsOk then return false, "File system not available" end
    name = safeName(name)
    if name == "" then return false, "Invalid name" end
