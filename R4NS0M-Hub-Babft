local function tkAdd(def)
    def.id = TK.nextId TK.nextId += 1
    local n = #TK.defs
    def.x = 0.5 + ((n % 5) - 2) * 0.09
    def.y = 0.45 + math.floor(n / 5) * 0.12
    def.parsed = def.key and parseKey(def.key) or nil
    table.insert(TK.defs, def)
    tkSave()
    if S.tkShow then tkMake(def) end
    tkRefreshList()
end

