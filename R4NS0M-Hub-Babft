---------------------------------------------------------------- BLUEPRINTS (archivos)
local fsOk = typeof(writefile) == "function" and typeof(readfile) == "function"
    and typeof(isfolder) == "function" and typeof(makefolder) == "function" and typeof(listfiles) == "function"
local BP_DIR, IMG_DIR = FOLDER .. "/blueprints", FOLDER .. "/images"
if fsOk then
    for _, d in ipairs({ FOLDER, BP_DIR, IMG_DIR }) do
        if not isfolder(d) then pcall(makefolder, d) end
    end
end

local function listNames(dir)
    local out = {}
    if not fsOk then return out end
    local ok, files = pcall(listfiles, dir)
    if ok then
        for _, f in ipairs(files) do
            local n = f:match("([^/\\]+)%.json$")
            if n then table.insert(out, n) end
        end
    end
    table.sort(out)
    return out
end

--[[ Formato del blueprint (.json):
{ "blocks": [ { "n":"WoodBlock", "p":[x,y,z], "r":[rx,ry,rz], "c":"RRGGBB", "s":[sx,sy,sz] }, ... ] }
p = posicion relativa al origen (stud), r = rotacion en grados, s = escala (opcional) ]]
local function loadBlueprint(name)
    if not fsOk then return nil, "File system not available" end
    local ok, data = pcall(function() return HttpService:JSONDecode(readfile(BP_DIR .. "/" .. name .. ".json")) end)
    if not ok or type(data) ~= "table" or type(data.blocks) ~= "table" then return nil, "Invalid blueprint" end
    for _, b in ipairs(data.blocks) do b.r = b.r or { 0, 0, 0 } end
    return data.blocks
end

---------------------------------------------------------------- BUILD ENGINE
local Build = { running = false, done = 0, total = 0 }

--[[ ADAPTADOR DE COLOCACION
    Aqui es donde se habla con el servidor del juego. Hay que completarlo con la
    firma real del remote del BuildingTool (se saca con SimpleSpy/Dex colocando 1 bloque).
    Se puede sobrescribir desde fuera:  getgenv().R4N_Babft.PlaceBlock = function(b, cf) ... end
    b  = { n = nombre, c = "RRGGBB", s = {x,y,z} }     cf = CFrame mundo
    Debe devolver: true  |  false, "motivo"
]]
Hub.PlaceBlock = function(b, cf)
    return false, "PlaceBlock adapter not configured yet (see 'Inspect building tool')"
end

local function buildingTool()
    return (LP.Backpack and LP.Backpack:FindFirstChild("BuildingTool"))
        or (char() and char():FindFirstChild("BuildingTool"))
end

local function inspectTool()
    local tool = buildingTool()
    if not tool then notify("Build", "BuildingTool not found (equip/have the build tool).", 4, "x") return end
    print("[R4NS0M] BuildingTool:", tool:GetFullName())
    for _, d in ipairs(tool:GetDescendants()) do
        print("  ", d.ClassName, d:GetFullName())
    end
    notify("Build", "Tool tree printed to console (F9).", 4, "terminal")
end

local function runBuild(blocks)
    if Build.running then notify("Build", "Already building.", 3, "alert-circle") return end
    local r = hrp()
    if not r then return end
    Build.running, Build.done, Build.total = true, 0, #blocks
    local origin = CFrame.new(r.Position + Vector3.new(0, S.buildY, 0))
    task.spawn(function()
        for i, b in ipairs(blocks) do
            if not Build.running then break end
            local rot = CFrame.Angles(math.rad(b.r[1]), math.rad(b.r[2]), math.rad(b.r[3]))
            local cf = origin * CFrame.new(b.p[1], b.p[2], b.p[3]) * rot
            local ok, res, why = pcall(Hub.PlaceBlock, b, cf)
            if not ok or res == false then
                notify("Build stopped", tostring(ok and why or res), 6, "x")
                break
            end
            Build.done = i
            if i % math.max(1, S.batch) == 0 then task.wait(S.buildDelay) end
        end
        local finished = Build.done == Build.total
        Build.running = false
        notify("Build", finished and "Finished." or ("Stopped at %d / %d"):format(Build.done, Build.total), 4, finished and "check" or "square")
    end)
end

