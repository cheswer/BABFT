-- Los IDs de "imagen" que se sacan del catalogo suelen ser Decals: un Decal no se
-- dibuja en un ImageLabel. Se resuelve a la textura real antes de dar el icono a WindUI.
local function resolveIcon(id)
    local fallback = "rbxassetid://" .. id
    local ok, tex = pcall(function()
        local objs = game:GetObjects("rbxassetid://" .. id)
        local o = objs and objs[1]
        if not o then return nil end
        local t
        if o:IsA("Decal") or o:IsA("Texture") then t = o.Texture
        elseif o:IsA("ImageLabel") or o:IsA("ImageButton") then t = o.Image
        else
            local d = o:FindFirstChildWhichIsA("Decal", true)
            t = d and d.Texture
        end
        pcall(function() o:Destroy() end)
        return t
    end)
    if ok and type(tex) == "string" and tex ~= "" then
        local real = tex:match("id=(%d+)") or tex:match("rbxassetid://(%d+)")
        if real then return "rbxassetid://" .. real end
        return tex
    end
    return fallback
end
