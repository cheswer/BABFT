TabCommunity:Button({ Title = "Publish to the cloud", Icon = "upload", Callback = function()
    if not S.upBP then notify("Upload", "Select one of your saved builds.", 3, "alert-circle") return end
    local title = S.upTitle:gsub("^%s+", ""):gsub("%s+$", "")
    if #title < 3 then notify("Upload", "Write a title (3+ characters).", 3, "alert-circle") return end
    if os.clock() - Cat.lastUp < 30 then notify("Upload", "Wait a few seconds between uploads.", 3, "clock") return end
    local blocks, err = loadBlueprint(S.upBP)
    if not blocks then notify("Upload", tostring(err), 4, "x") return end
    if #blocks > 6000 then notify("Upload", "Too many blocks (max 6000).", 4, "x") return end
    local compact = {}
    for i, b in ipairs(blocks) do
        compact[i] = { n = b.n, p = { r2(b.p[1]), r2(b.p[2]), r2(b.p[3]) }, r = { r2(b.r[1]), r2(b.r[2]), r2(b.r[3]) },
            c = b.c, s = b.s and { r2(b.s[1]), r2(b.s[2]), r2(b.s[3]) } or nil }
    end
    local id = ("%011d_%s"):format(os.time(), HttpService:GenerateGUID(false):sub(1, 4))
    local ok, e1 = cloud("PUT", "/blueprints/" .. id .. ".json", HttpService:JSONEncode(compact))
    if not ok then notify("Upload", tostring(e1), 5, "x") return end
    local ok2, e2 = cloud("PUT", "/catalog/" .. id .. ".json", {
        name = title:sub(1, 40), desc = S.upDesc:sub(1, 200), author = LP.DisplayName, authorId = LP.UserId,
        blocks = #blocks, ts = os.time(), downloads = 0, reports = 0,
    })
    if not ok2 then notify("Upload", tostring(e2), 5, "x") return end
    Cat.lastUp = os.clock()
    notify("Upload", "Published: " .. title, 4, "check")
end })

