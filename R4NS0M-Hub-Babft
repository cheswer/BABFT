local function tkMake(def)
    local gui = tkGui()
    local isJoy = def.type == "joystick"
    local b = Instance.new("TextButton")
    b.Name = "tk_" .. def.id
    b.AnchorPoint = Vector2.new(0.5, 0.5)
    b.Size = UDim2.fromOffset(def.size, def.size)
    b.Position = UDim2.fromScale(def.x, def.y)
    b.BackgroundColor3 = NAVY b.BackgroundTransparency = S.tkOpacity
    b.AutoButtonColor = false
    b.Text = isJoy and "" or def.label
    b.TextColor3 = CREAM b.Font = Enum.Font.GothamBold b.TextScaled = true
    b.Parent = gui
    local c = Instance.new("UICorner") c.CornerRadius = UDim.new(1, 0) c.Parent = b
    local stroke = Instance.new("UIStroke") stroke.Thickness = 2 stroke.Color = S.tkLocked and GOLD or RED stroke.Parent = b
    local thumb
    if isJoy then
        thumb = Instance.new("Frame")
        thumb.AnchorPoint = Vector2.new(0.5, 0.5) thumb.Position = UDim2.fromScale(0.5, 0.5)
        thumb.Size = UDim2.fromScale(0.42, 0.42) thumb.BackgroundColor3 = GOLD thumb.BackgroundTransparency = 0.15
        thumb.Parent = b
        local tc = Instance.new("UICorner") tc.CornerRadius = UDim.new(1, 0) tc.Parent = thumb
    else
        local pad = Instance.new("UIPadding")
        pad.PaddingLeft = UDim.new(0, 10) pad.PaddingRight = UDim.new(0, 10) pad.PaddingTop = UDim.new(0, 10) pad.PaddingBottom = UDim.new(0, 10)
        pad.Parent = b
    end

    local dragging, dragObj, dragStart, startPos = false, nil, nil, nil
    local joyInput, joyOrigin
    local obj = { b = b, stroke = stroke, keys = {} }
    obj.conn = UIS.InputChanged:Connect(function(input)
        if joyInput and input == joyInput then
            local v = (Vector2.new(input.Position.X, input.Position.Y) - joyOrigin) / (b.AbsoluteSize.X / 2)
            if v.Magnitude > 1 then v = v.Unit end
            thumb.Position = UDim2.fromScale(0.5 + v.X * 0.29, 0.5 + v.Y * 0.29)
            joyApply(obj, v)
        end
        if dragging and dragObj and (input == dragObj
            or (dragObj.UserInputType == Enum.UserInputType.MouseButton1 and input.UserInputType == Enum.UserInputType.MouseMovement)) then
            local d = input.Position - dragStart
            b.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
        end
    end)
    b.InputBegan:Connect(function(input)
        local t = input.UserInputType
        if t ~= Enum.UserInputType.Touch and t ~= Enum.UserInputType.MouseButton1 then return end
        if S.tkLocked then
            if isJoy then
                joyInput, joyOrigin = input, Vector2.new(input.Position.X, input.Position.Y)
                local cc
                cc = input.Changed:Connect(function()
                    if input.UserInputState == Enum.UserInputState.End then
                        cc:Disconnect() joyInput = nil joyRelease(obj, thumb)
                    end
                end)
            elseif def.mode == "Toggle" then
                def.on = not def.on
                tkFire(def, def.on)
                b.BackgroundColor3 = def.on and GOLD or NAVY
            elseif def.mode == "Hold" then
                tkFire(def, true) b.BackgroundColor3 = GOLD
                local cc
                cc = input.Changed:Connect(function()
                    if input.UserInputState == Enum.UserInputState.End then
                        cc:Disconnect() tkFire(def, false) b.BackgroundColor3 = NAVY
                    end
                end)
            else
                tkFire(def, true) b.BackgroundColor3 = GOLD
                task.delay(0.06, function() tkFire(def, false) b.BackgroundColor3 = NAVY end)
            end
        else
            dragging, dragObj, dragStart, startPos = true, input, input.Position, b.Position
            local cc
            cc = input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    cc:Disconnect() dragging = false
                    local vs = gui.AbsoluteSize
                    local ap = b.AbsolutePosition + b.AbsoluteSize / 2
                    def.x = math.clamp(ap.X / vs.X, 0.02, 0.98)
                    def.y = math.clamp(ap.Y / vs.Y, 0.02, 0.98)
                    tkSave()
                end
            end)
        end
    end)
    TK.objs[def.id] = obj
end

local function tkRender()
