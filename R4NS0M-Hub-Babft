local function tkLabels()
    local labels = {}
    TK.map = {}
    for _, d in ipairs(TK.defs) do
        local l = ("%s  (%s)  #%d"):format(d.label, tostring(d.action or d.key or d.type or ""), d.id)
        TK.map[l] = d.id
        labels[#labels + 1] = l
    end
    if #labels == 0 then labels = { "(no buttons yet)" } end
    return labels
end
