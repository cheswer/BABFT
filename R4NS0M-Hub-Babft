    -- touchpad
    local sp = TK.autoPos.pad
    local pad = Instance.new("Frame")
    pad.AnchorPoint = Vector2.new(0.5, 0.5)
    pad.Position = UDim2.fromScale(sp and tonumber(sp.x) or 0.80, sp and tonumber(sp.y) or 0.36)
    pad.Size = UDim2.fromOffset(S.padW, S.padH)
    pad.BackgroundColor3 = NAVY pad.BackgroundTransparency = 0.55 pad.Active = true
    pad.Parent = g
    local pc = Instance.new("UICorner") pc.CornerRadius = UDim.new(0, 14) pc.Parent = pad
    local ps = Instance.new("UIStroke") ps.Thickness = 1.5 ps.Color = GOLD ps.Transparency = 0.3 ps.Parent = pad
    local pl = Instance.new("TextLabel")
    pl.BackgroundTransparency = 1 pl.Size = UDim2.new(1, 0, 0, 18) pl.Position = UDim2.fromOffset(0, 4)
    pl.Text = "TOUCHPAD" pl.Font = Enum.Font.GothamBold pl.TextSize = 11 pl.TextColor3 = GOLD pl.TextTransparency = 0.4
    pl.Parent = pad
    CursorUI.pad = pad

    local padInput, padLast, padT0, padMoved
    local dragging, dragObj, dragStart, startPos = false, nil, nil, nil
    pad.InputBegan:Connect(function(input)
        local t = input.UserInputType
        if t ~= Enum.UserInputType.Touch and t ~= Enum.UserInputType.MouseButton1 then return end
        if S.tkLocked then
            padInput, padLast, padT0, padMoved = input, Vector2.new(input.Position.X, input.Position.Y), os.clock(), 0
            local cc
            cc = input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    cc:Disconnect()
                    if padInput == input then
                        padInput = nil
                        if S.cursorTap and os.clock() - padT0 < 0.25 and padMoved < 12 then cursorClick(0) end
                    end
                end
            end)
        else
            dragging, dragObj, dragStart, startPos = true, input, input.Position, pad.Position
            local cc
            cc = input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    cc:Disconnect() dragging = false
                    local vs = g.AbsoluteSize
                    local ap = pad.AbsolutePosition + pad.AbsoluteSize / 2
                    TK.autoPos.pad = { x = math.clamp(ap.X / vs.X, 0.05, 0.95), y = math.clamp(ap.Y / vs.Y, 0.05, 0.95) }
                    tkSave()
                end
            end)
        end
    end)
    table.insert(CursorUI.conns, UIS.InputChanged:Connect(function(input)
        if padInput and input == padInput then
            local now = Vector2.new(input.Position.X, input.Position.Y)
            local d = now - padLast
            padLast = now
            padMoved += d.Magnitude
            local mult = S.cursorSpeedOn and S.cursorSpeed or 1
            Cursor.x += d.X * mult
            Cursor.y += d.Y * mult
            cursorClamp() cursorRefresh() cursorMoveReal()
        end
        if dragging and dragObj and (input == dragObj
            or (dragObj.UserInputType == Enum.UserInputType.MouseButton1 and input.UserInputType == Enum.UserInputType.MouseMovement)) then
            local d = input.Position - dragStart
            pad.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
        end
    end))
    -- modo "Follow touch": el cursor va donde tocas el mundo
    local function follow(input, gp)
        if Cursor.on and S.cursorMode == "Follow touch" and not gp and input.UserInputType == Enum.UserInputType.Touch then
            Cursor.x = input.Position.X
            Cursor.y = input.Position.Y + GuiService:GetGuiInset().Y
            cursorClamp() cursorRefresh() cursorMoveReal()
        end
    end
    table.insert(CursorUI.conns, UIS.InputBegan:Connect(follow))
    table.insert(CursorUI.conns, UIS.InputChanged:Connect(follow))
    cursorRefresh()
end

local function cursorSet(v)
    v = v and true or false
    if v then
        if not installHooks() then notify("Mouse", "No metamethod hooks: the game won't read the virtual mouse, only the visual cursor moves.", 5, "alert-triangle") end
        local vs = workspace.CurrentCamera.ViewportSize
        if not Cursor.on then Cursor.x, Cursor.y = vs.X / 2, vs.Y / 2 end
        Cursor.on = true
        cursorBuild()
        CursorUI.gui.Enabled = true
    else
        Cursor.on = false
        if CursorUI.gui then CursorUI.gui.Enabled = false end
    end
    S.cursorOn = Cursor.on
    cursorRefresh()
end

function Hub.destroyCursor()
